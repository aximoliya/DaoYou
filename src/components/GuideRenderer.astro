---
/**
 * 通用攻略渲染组件
 * 从 GuideData 数据渲染完整的攻略页面
 */
import type { GuideData, ContentBlock } from '../data/guides/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import NavBar from './NavBar.astro';
import Breadcrumb from './Breadcrumb.astro';
import TimeBadge from './TimeBadge.astro';
import TOCPanel from './TOCPanel.astro';
import PageNav from './PageNav.astro';
import BackToTop from './BackToTop.astro';
import { kaixiangNavItems, richangNavItems, yangchengNavItems, reviewsNavItems } from '../data/navItems';

interface Props {
  guide: GuideData;
  currentPath: string;
}

const { guide, currentPath } = Astro.props;

// 根据分类选择导航数据
const navMap: Record<string, any[]> = {
  '/kaixiang/': kaixiangNavItems,
  '/richang/': richangNavItems,
  '/yangcheng/': yangchengNavItems,
  '/reviews/': reviewsNavItems,
};
const navItems = navMap[guide.categoryHref] || kaixiangNavItems;
---

<BaseLayout title={`${guide.title} · 道友攻略`} page={guide.id} current={guide.id}>
  <NavBar currentPage={currentPath} navItems={navItems} />

  <main>
    <Breadcrumb items={[
      { href: '../../', label: '攻略总览' },
      { href: '../', label: guide.category },
      { label: guide.title }
    ]} />
    <TimeBadge date={guide.updateDate} version={guide.version} />

    <section id={guide.id}>
      <h2><span class="icon">{guide.icon}</span>{guide.title}</h2>

      {guide.sections?.map(section => (
        <>
          <h3>
            {section.badge && <span class={`badge badge-${section.badge}`}>{section.badge === 'xh' ? '曦幻' : section.badge === 'll' ? '琉璃' : section.badge === 'jx' ? '金霄' : section.badge === 'ct' ? '赤魇' : section.badge === 'zx' ? '紫虚' : section.badge === 'qy' ? '青曜' : section.badge === 'hc' ? '幻彩' : section.badge}</span>}
            {section.title}
          </h3>

          {section.blocks?.map(block => {
            switch (block.type) {
              case 'text':
                return <p style="font-size:13px;color:var(--text-muted);margin-bottom:8px;">{block.content}</p>;
              
              case 'info':
                return <div class="info" data-tiers={block.tiers} set:html={block.content} />;
              
              case 'warn':
                return <div class="warn" data-tiers={block.tiers} set:html={block.content} />;
              
              case 'card':
                return (
                  <div class="card" data-tiers={block.tiers}>
                    <div class="card-title">{block.title}</div>
                    {block.content && <div class="flow" data-tiers={block.tiers} set:html={block.content} />}
                    {block.note && <p style="font-size:12px;color:var(--text-muted);margin-top:6px;" set:html={block.note} />}
                  </div>
                );
              
              case 'flow':
                return (
                  <div class="flow" data-tiers={block.tiers} style="margin:8px 0;">
                    {block.steps?.map((step, i) => (
                      <>
                        <span class="step">{step}</span>
                        {i < (block.steps?.length || 0) - 1 && <span class="arrow">→</span>}
                      </>
                    ))}
                  </div>
                );
              
              case 'route':
                return (
                  <ul class="route" data-tiers={block.tiers} style="margin-top:8px;">
                    {block.items?.map(item => (
                      <li set:html={item} />
                    ))}
                  </ul>
                );
              
              case 'table':
                return (
                  <table data-tiers={block.tiers}>
                    <tr>{block.headers?.map(h => <th>{h}</th>)}</tr>
                    {block.rows?.map(row => (
                      <tr>{row?.map(cell => <td set:html={cell} />)}</tr>
                    ))}
                  </table>
                );
              
              default:
                return null;
            }
          })}
        </>
      ))}
    </section>

    <TOCPanel />
    <PageNav currentPath={currentPath} navItems={navItems} />
  </main>

  <BackToTop />
</BaseLayout>
