---
/**
 * 通用攻略渲染组件
 * 从 GuideData 数据渲染完整的攻略页面
 */
import type { GuideData } from '../data/guides/types';
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from './AppShell.astro';
import Breadcrumb from './Breadcrumb.astro';
import TimeBadge from './TimeBadge.astro';
import Icon from './Icon.astro';
import TOCPanel from './TOCPanel.astro';
import PageNav from './PageNav.astro';
import BackToTop from './BackToTop.astro';
import { kaixiangNavItems, richangNavItems, yangchengNavItems, reviewsNavItems } from '../data/navItems';

interface Props {
  guide: GuideData;
  currentPath: string;
}

const { guide, currentPath } = Astro.props;

// 根据分类选择导航数据（用于上一篇/下一篇）
const navMap: Record<string, any[]> = {
  '/kaixiang/': kaixiangNavItems,
  '/richang/': richangNavItems,
  '/yangcheng/': yangchengNavItems,
  '/reviews/': reviewsNavItems,
};
const navItems = navMap[guide.categoryHref] || kaixiangNavItems;
---

<BaseLayout title={`${guide.title} · 道友攻略`} page={guide.id} current={guide.id}>
  <AppShell current={currentPath}>
    <Fragment slot="rail">
      <TOCPanel />
      <div class="rail-card rail-note">
        <h3 class="rail-card-title"><Icon name="pin" size={16} />更新信息</h3>
        <p>{guide.version ? `${guide.version} · ` : ''}{guide.updateDate}</p>
        {guide.sourceUrl && (
          <a href={guide.sourceUrl} target="_blank" rel="noopener" class="rail-note-link">攻略来源：{guide.sourceAuthor || 'TapTap'} →</a>
        )}
      </div>
    </Fragment>

    <Breadcrumb items={[
      { href: '../../', label: '攻略总览' },
      { href: '../', label: guide.category },
      { label: guide.title }
    ]} />
    <TimeBadge date={guide.updateDate} version={guide.version} />

    <section id={guide.id}>
      <h2><span class="h2-icon"><Icon name={guide.icon} size={24} /></span>{guide.title}</h2>

      {guide.sections?.map(section => (
        <>
          <h3>
            {section.title}
          </h3>

          {section.blocks?.map(block => {
            switch (block.type) {
              case 'text':
                return <p class="block-text" set:html={block.content} />;

              case 'info':
                return <div class="info" set:html={block.content} />;

              case 'warn':
                return <div class="warn" set:html={block.content} />;

              case 'card':
                return (
                  <div class="card">
                    <div class="card-title" set:html={block.title} />
                    {block.content && <div class="flow" set:html={block.content} />}
                    {block.note && <p class="card-note" set:html={block.note} />}
                  </div>
                );

              case 'heading':
                return <h4 class="subheading" set:html={block.text} />;

              case 'flow':
                return (
                  <div class="flow" style="margin:8px 0;">
                    {block.steps?.map((step, i) => (
                      <>
                        <span class="step" set:html={step} />
                        {i < (block.steps?.length || 0) - 1 && <span class="arrow">→</span>}
                      </>
                    ))}
                    {block.note && <span class="flow-note" set:html={block.note} />}
                  </div>
                );

              case 'route':
                return (
                  <ul class="route" style="margin-top:8px;">
                    {block.items?.map(item => (
                      <li set:html={item} />
                    ))}
                  </ul>
                );

              case 'table':
                return (
                  <div class="table-wrap">
                    <table>
                      <tr>{block.headers?.map(h => <th>{h}</th>)}</tr>
                      {block.rows?.map(row => (
                        <tr>{row?.map(cell => <td set:html={cell} />)}</tr>
                      ))}
                    </table>
                  </div>
                );

              default:
                return null;
            }
          })}
        </>
      ))}
    </section>

    <PageNav currentPath={currentPath} navItems={navItems} />
  </AppShell>

  <BackToTop />
</BaseLayout>
