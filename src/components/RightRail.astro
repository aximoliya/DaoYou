---
import { hotTags } from '../data/sidebarNav';
import Icon from './Icon.astro';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');
---

<div class="rail-quote">
  <div class="quote-text">
    和道友<br>一起走更远的路！
  </div>
  <span class="quote-stroke"></span>
</div>

<div class="rail-card hot-tags">
  <h3 class="rail-card-title"><Icon name="flame" size={16} />热门标签</h3>
  <div class="tag-cloud">
    {hotTags.map(t => (
      <a href={`${BASE}${t.href.replace(/^\//, '')}`} class="tag-pill">{t.label}</a>
    ))}
  </div>
</div>

<div class="rail-card rail-note">
  <h3 class="rail-card-title"><Icon name="mail" size={16} />关于本站</h3>
  <p>攻略内容整理自 TapTap 作者「<b>笑语</b>」，纯静态站，持续跟进版本更新。</p>
  <a href={`${BASE}reviews/`} class="rail-note-link">查看最新测评 →</a>
</div>
