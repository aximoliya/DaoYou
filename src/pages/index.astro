---
import BaseLayout from '../layouts/BaseLayout.astro';
import AppShell from '../components/AppShell.astro';
import HeroBanner from '../components/HeroBanner.astro';
import GuideList from '../components/GuideList.astro';
import RightRail from '../components/RightRail.astro';
import BackToTop from '../components/BackToTop.astro';
import Icon from '../components/Icon.astro';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

// 首页 4 个精选系统入口（对齐设计稿）
const featured = [
  { href: '/kaixiang/shenxian/', label: '神仙', icon: 'user', color: '#709BFC' },
  { href: '/kaixiang/tianshu/',  label: '天书', icon: 'book', color: '#A2A1FA' },
  { href: '/kaixiang/xingji/',   label: '星姬', icon: 'star', color: '#FDA9BC' },
  { href: '/kaixiang/huanxian/', label: '幻仙', icon: 'sparkles', color: '#6FCFA4' },
];

// 全部分类
const modules = [
  { href: '/kaixiang/', label: '开箱攻略', icon: 'package', desc: '10 大子系统开箱路线' },
  { href: '/reviews/',  label: '道具测评', icon: 'flask', desc: '新道具深度解析' },
  { href: '/richang/',  label: '日常运营', icon: 'cart', desc: '商店购买与活动兑换' },
  { href: '/yangcheng/', label: '养成系统', icon: 'landmark', desc: '神藏节点升级路线' },
];
---

<BaseLayout title="道友请留步 · 攻略总览" page="hub" current="/">
  <AppShell current="/">
    <Fragment slot="rail"><RightRail /></Fragment>

    <HeroBanner />

    <!-- 4 个精选系统入口 -->
    <div class="cat-row">
      {featured.map(f => (
        <a href={`${BASE}${f.href.replace(/^\//, '')}`} class="cat-card">
          <span class="cat-icon" style={`--cat-color:${f.color};`}><Icon name={f.icon} size={19} /></span>
          <span class="cat-name">{f.label}</span>
          <span class="cat-arrow">›</span>
        </a>
      ))}
    </div>

    <!-- 最新攻略 -->
    <GuideList />

    <!-- 全部分类 -->
    <section class="module-section">
      <div class="section-head">
        <h2 class="section-title">全部分类</h2>
      </div>
      <div class="module-grid">
        {modules.map(m => (
          <a href={`${BASE}${m.href.replace(/^\//, '')}`} class="module-card">
            <span class="module-icon"><Icon name={m.icon} size={20} /></span>
            <span class="module-label">{m.label}</span>
            <span class="module-desc">{m.desc}</span>
          </a>
        ))}
      </div>
    </section>

    <div class="hub-updated">内容来源：笑语@TapTap · 最后更新 2026-09-27</div>
  </AppShell>

  <BackToTop />
</BaseLayout>
