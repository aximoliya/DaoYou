---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../components/AppShell.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BackToTop from '../../components/BackToTop.astro';
import Icon from '../../components/Icon.astro';
import TimeBadge from '../../components/TimeBadge.astro';

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/?$/, '/');

const items = [
  { href: 'shenxian/', icon: 'user', label: '一、神仙', desc: '曦幻/琉璃品质开箱路线' },
  { href: 'tianshu/',  icon: 'book', label: '二、天书', desc: '各品质天书强度与顺序' },
  { href: 'xingji/',   icon: 'star', label: '三、星姬', desc: '曦幻琉璃星姬升星路线' },
  { href: 'huanxian/', icon: 'sparkles', label: '四、幻仙', desc: '各品质幻仙开箱优先级' },
  { href: 'chongwu/',  icon: 'paw', label: '五、宠物', desc: '曦幻/琉璃/金霄宠物路线' },
  { href: 'lingwu/',   icon: 'sword', label: '六、灵武', desc: '各品质灵武开法与配置' },
  { href: 'yuanshen/', icon: 'gem', label: '七、元神', desc: '曦幻元神星级与替换规则' },
  { href: 'fabao/',    icon: 'orb', label: '八、法宝', desc: '琉璃/金霄法宝开法' },
  { href: 'zhuangbei/',icon: 'shield', label: '九、装备', desc: '曦幻装备化神阶数路线' },
  { href: 'duoxuan/',  icon: 'package', label: '十、道具多选箱', desc: '琉璃/金霄多选箱优先级' },
];
---

<BaseLayout title="开箱攻略 · 道友攻略" page="kaixiang" current="/kaixiang/">
  <AppShell current="/kaixiang/">
    <Breadcrumb items={[{ href: '../', label: '攻略总览' }, { label: '开箱攻略' }]} />
    <TimeBadge date="2026-09-27" version="曦幻三版本" />

    <section>
      <h2 class="page-title"><Icon name="package" size={25} />开箱攻略</h2>
      <p class="page-lead">选择你想查看的开箱攻略：</p>
      <div class="hub-grid">
        {items.map(i => (
          <a href={i.href} class="hub-card">
            <Icon name={i.icon} size={24} />
            <span class="label">{i.label}</span>
            <span class="desc">{i.desc}</span>
          </a>
        ))}
      </div>
    </section>
  </AppShell>
  <BackToTop />
</BaseLayout>
