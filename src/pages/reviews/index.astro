---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../components/AppShell.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BackToTop from '../../components/BackToTop.astro';
import Icon from '../../components/Icon.astro';

const items = [
  { href: 'guixu/', icon: 'orb', label: '归墟葬星图', desc: '曦幻天书 · 辅助定位 · 延缓登场 · 控制降神' },
];
---

<BaseLayout title="道具测评 · 道友攻略" page="reviews" current="/reviews/">
  <AppShell current="/reviews/">
    <Breadcrumb items={[{ href: '../', label: '攻略总览' }, { label: '道具测评' }]} />

    <section>
      <h2 class="page-title"><Icon name="flask" size={25} />道具测评</h2>
      <p class="page-lead">新道具深度解析，技能讲解与实战搭配：</p>
      <div class="hub-grid">
        {items.map(i => (
          <a href={i.href} class="hub-card">
            <Icon name={i.icon} size={24} />
            <span class="label">{i.label}</span>
            <span class="desc">{i.desc}</span>
          </a>
        ))}
      </div>
    </section>
  </AppShell>
  <BackToTop />
</BaseLayout>
