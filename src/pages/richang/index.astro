---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../components/AppShell.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BackToTop from '../../components/BackToTop.astro';
import Icon from '../../components/Icon.astro';
import TimeBadge from '../../components/TimeBadge.astro';

const items = [
  { href: 'shop/', icon: 'cart', label: '商店购买', desc: '30+ 商店日常购买优先级指南' },
  { href: 'huodong/', icon: 'ticket', label: '活动购买兑换', desc: '出村后主题活动/书阁/神石/晶源幻境兑换' },
];
---

<BaseLayout title="日常运营 · 道友攻略" page="richang" current="/richang/">
  <AppShell current="/richang/">
    <Breadcrumb items={[{ href: '../', label: '攻略总览' }, { label: '日常运营' }]} />
    <TimeBadge date="2026-09-27" version="曦幻三版本" />

    <section>
      <h2 class="page-title"><Icon name="cart" size={25} />日常运营</h2>
      <p class="page-lead">日常商店购买优先级指南：</p>
      <div class="hub-grid">
        {items.map(i => (
          <a href={i.href} class="hub-card">
            <Icon name={i.icon} size={24} />
            <span class="label">{i.label}</span>
            <span class="desc">{i.desc}</span>
          </a>
        ))}
      </div>
    </section>
  </AppShell>
  <BackToTop />
</BaseLayout>
