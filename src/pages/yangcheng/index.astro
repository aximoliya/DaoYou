---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AppShell from '../../components/AppShell.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import BackToTop from '../../components/BackToTop.astro';
import Icon from '../../components/Icon.astro';
import TimeBadge from '../../components/TimeBadge.astro';

const items = [
  { href: 'shencang/', icon: 'landmark', label: '神藏系统', desc: '节点升级路线、战力与胜率实测数据' },
];
---

<BaseLayout title="养成系统 · 道友攻略" page="yangcheng" current="/yangcheng/">
  <AppShell current="/yangcheng/">
    <Breadcrumb items={[{ href: '../', label: '攻略总览' }, { label: '养成系统' }]} />
    <TimeBadge date="2026-09-27" version="曦幻三版本" />

    <section>
      <h2 class="page-title"><Icon name="landmark" size={25} />养成系统</h2>
      <p class="page-lead">角色成长与资源分配攻略：</p>
      <div class="hub-grid">
        {items.map(i => (
          <a href={i.href} class="hub-card">
            <Icon name={i.icon} size={24} />
            <span class="label">{i.label}</span>
            <span class="desc">{i.desc}</span>
          </a>
        ))}
      </div>
    </section>
  </AppShell>
  <BackToTop />
</BaseLayout>
